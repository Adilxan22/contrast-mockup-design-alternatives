# Poster POS API — токены по каждому аккаунту (см. docs/PROJECT_SPEC.md, раздел 1.4)
POSTER_CONNECT_TOKEN=
POSTER_API_TOKEN_LEFT=
POSTER_API_TOKEN_CENTRE=
POSTER_API_TOKEN_ALFARABI=

# Yandex Delivery API
YANDEX_DELIVERY_TOKEN=

# WhatsApp Cloud API (Meta) — уведомление менеджера о новом заказе.
# Без токена уведомление просто логируется, чекаут не блокируется.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_MANAGER_PHONE_LEFT=
WHATSAPP_MANAGER_PHONE_CENTRE=
WHATSAPP_MANAGER_PHONE_ALFARABI=

# Публичный номер для кнопки WhatsApp на сайте (формат 77XXXXXXXXX, без +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Домен продакшен-сайта — используется в sitemap.xml/robots.txt. До переноса на
# домен заказчика можно оставить пустым (используется дефолт-заглушка).
NEXT_PUBLIC_SITE_URL=

# Своя БД (Neon Postgres) — распарсенные атрибуты, сессии, согласие на ПДн,
# слайды hero, лог заказов. Poster остаётся источником истины для товаров/
# остатков/клиентов — см. docs/ARCHITECTURE.md.
# Оба пишутся автоматически командой `neon link` / `neon env pull` — вручную
# заполнять не нужно, если используется Neon CLI.
# DATABASE_URL — пулированная строка (с "-pooler" в хосте), для приложения.
# DATABASE_URL_UNPOOLED — обычная строка оттуда же, только для миграций.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Пароль единственного админ-аккаунта (/admin) и секрет для подписи cookie-сессий
# (общий для admin и личного кабинета — придумать длинную случайную строку).
ADMIN_PASSWORD=
SESSION_SECRET=
